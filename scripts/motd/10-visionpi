#!/bin/bash

CYAN='\033[1;36m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
RESET='\033[0m'

HOST="$(hostname)"
KERNEL="$(uname -r)"
IPV4="$(hostname -I | awk '{print $1}')"

TEMP_RAW="$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)"
if [ -n "$TEMP_RAW" ]; then
    TEMP="$(awk "BEGIN {printf \"%.1f°C\", $TEMP_RAW/1000}")"
else
    TEMP="unknown"
fi

echo -e "${WHITE}               /^._     ${CYAN}██╗   ██╗██╗███████╗██╗ ██████╗ ███╗   ██╗ ██████╗ ██╗"
echo -e "${WHITE}  ,___,--~~~~--' /'~    ${CYAN}██║   ██║██║██╔════╝██║██╔═══██╗████╗  ██║ ██╔══██╗██║"
echo -e "${WHITE}  \`~--~ )___,)/'   \\    ${BLUE}██║   ██║██║███████╗██║██║   ██║██╔██╗ ██║ ██████╔╝██║"
echo -e "${WHITE}      (/\\\\_  (/\\\\_        ${BLUE}╚██╗ ██╔╝██║╚════██║██║██║   ██║██║╚██╗██║ ██╔═══╝ ██║"
echo -e "${WHITE}                        ${MAGENTA} ╚████╔╝ ██║███████║██║╚██████╔╝██║ ╚████║ ██║     ██║"
echo -e "${WHITE}                        ${MAGENTA}  ╚═══╝  ╚═╝╚══════╝╚═╝ ╚═════╝ ╚═╝  ╚═══╝ ╚═╝     ╚═╝${RESET}"
echo -e "${YELLOW}              Wolf-powered vision node${RESET}"
echo -e "${WHITE}              VisionPi • Raspberry Pi 5${RESET}"
echo
echo -e "${GREEN} Host   ${RESET}: ${HOST}"
echo -e "${GREEN} Kernel ${RESET}: ${KERNEL}"
echo -e "${GREEN} IPv4   ${RESET}: ${IPV4}"
echo -e "${GREEN} Temp   ${RESET}: ${TEMP}"
echo
